
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Super Ludo Game</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#172033;color:white;
 font-family:Arial,sans-serif;text-align:center;
}
h1{color:#ffd43b;margin:15px}
button{cursor:pointer;border:0;border-radius:12px;
 padding:12px 18px;font-weight:bold;font-size:16px}
.menu{padding:15px}
.menu button{margin:5px;background:#ffd43b}
#game{display:none;padding:10px}
.info{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:12px}
.info span{padding:10px;border-radius:10px;background:#293750}
#board{
 width:min(94vw,520px);height:min(94vw,520px);
 margin:15px auto;position:relative;
 background:#f5edda;border:7px solid white;
 border-radius:20px;overflow:hidden;
}
.center{
 position:absolute;left:50%;top:50%;
 transform:translate(-50%,-50%);
 width:24%;height:24%;border-radius:50%;
 background:linear-gradient(135deg,#ffcc33,#ff7043);
 display:grid;place-items:center;color:#222;
 font-weight:bold;z-index:2;
}
.cell{
 position:absolute;width:5.5%;height:5.5%;
 border-radius:50%;background:#d9d9d9;
 border:1px solid #888;transform:translate(-50%,-50%);
}
.safe{background:#fff3a0}
.token{
 position:absolute;width:9%;height:9%;
 border-radius:50%;border:3px solid white;
 box-shadow:0 2px 7px #333;
 transform:translate(-50%,-50%);
 z-index:5;color:white;font-weight:bold;
 display:grid;place-items:center;
 font-size:12px;
}
.red{background:#ef3030}
.blue{background:#2585f5}
.green{background:#19a65a}
.yellow{background:#e9b500;color:#222}
.token.selected{outline:4px solid #222;z-index:10}
.controls{margin:15px}
#dice{
 font-size:45px;background:white;color:#222;
 width:85px;height:85px;border-radius:18px;
 margin:10px auto;display:grid;place-items:center;
 box-shadow:0 4px 10px #0005;
}
#roll{background:#ffcc33;color:#222;font-size:19px}
#message{padding:12px;font-size:17px;min-height:40px}
#players{display:flex;justify-content:center;flex-wrap:wrap;gap:8px}
.player{padding:9px 13px;background:#293750;border-radius:10px}
#win{display:none;position:fixed;inset:0;background:#000e;
 z-index:20;align-items:center;justify-content:center;padding:20px}
.winbox{background:#fff;color:#222;padding:30px;border-radius:20px}
.winbox h2{font-size:30px}
.winbox button{background:#ffcc33}
</style>
</head>
<body>

<h1>🎲 SUPER LUDO 🎲</h1>

<div class="menu" id="menu">
<h2>कितने खिलाड़ी खेलेंगे?</h2>
<button onclick="startGame(2)">2 Players</button>
<button onclick="startGame(3)">3 Players</button>
<button onclick="startGame(4)">4 Players</button>
</div>

<div id="game">
<div id="players"></div>
<div class="info">
<span id="turn">बारी: लाल</span>
<span id="status">पासा फेंकें</span>
</div>

<div id="board">
<div class="center">🏆 LUDO</div>
</div>

<div class="controls">
<div id="dice">🎲</div>
<button id="roll" onclick="rollDice()">पासा फेंको</button>
<div id="message">अपनी बारी का इंतजार करें</div>
<br>
<button onclick="newGame()">🏠 Home</button>
</div>
</div>

<div id="win">
<div class="winbox">
<h2 id="winner">🏆 Winner!</h2>
<p>🎉 बधाई हो! 🎉</p>
<p>👏 👏 👏 👏</p>
<button onclick="newGame()">फिर से खेलें</button>
</div>
</div>

<script>
const colors=[
 {name:"लाल",color:"red",start:0},
 {name:"नीला",color:"blue",start:13},
 {name:"पीला",color:"yellow",start:26},
 {name:"हरा",color:"green",start:39}
];

let active=[],turn=0,dice=0,rolled=false;
let tokens=[],gameOver=false;
const board=document.getElementById("board");
const safe=[0,8,13,21,26,34,39,47];

function trackPosition(i,r=44){
 const angle=(-90+i*360/52)*Math.PI/180;
 return {
  x:50+Math.cos(angle)*r,
  y:50+Math.sin(angle)*r
 };
}

function startGame(n){
 active=n===2?[0,2]:n===3?[0,1,2]:[0,1,2,3];
 tokens=active.map(()=>Array(4).fill(-1));
 turn=0;rolled=false;dice=0;gameOver=false;
 document.getElementById("menu").style.display="none";
 document.getElementById("game").style.display="block";
 document.getElementById("win").style.display="none";
 createBoard();
 update();
}

function createBoard(){
 board.querySelectorAll(".cell,.token").forEach(e=>e.remove());

 for(let i=0;i<52;i++){
  let p=trackPosition(i);
  let c=document.createElement("div");
  c.className="cell"+(safe.includes(i)?" safe":"");
  c.style.left=p.x+"%";
  c.style.top=p.y+"%";
  board.appendChild(c);
 }
 drawTokens();
}

function drawTokens(){
 board.querySelectorAll(".token").forEach(e=>e.remove());

 active.forEach((colorIndex,pi)=>{
  for(let t=0;t<4;t++){
   let step=tokens[pi][t];
   let x,y;

   if(step===-1){
    let spots=[
     [[12,12],[23,12],[12,23],[23,23]],
     [[77,12],[88,12],[77,23],[88,23]],
     [[77,77],[88,77],[77,88],[88,88]],
     [[12,77],[23,77],[12,88],[23,88]]
    ];
    let pos=spots[colorIndex][t];
    x=pos[0];y=pos[1];
   }else if(step===57){
    x=50;y=50;
   }else if(step>=52){
    let p=trackPosition(colors[colorIndex].start,32-(step-52)*5);
    x=p.x;y=p.y;
   }else{
    let p=trackPosition((colors[colorIndex].start+step)%52);
    x=p.x;y=p.y;
   }

   let el=document.createElement("button");
   el.className="token "+colors[colorIndex].color;
   el.style.left=x+"%";
   el.style.top=y+"%";
   el.textContent=t+1;
   el.title=colors[colorIndex].name+" गोटी "+(t+1);
   if(rolled && pi===turn && canMove(pi,t))
    el.classList.add("selected");
   el.onclick=()=>moveToken(pi,t);
   board.appendChild(el);
  }
 });
}

function update(){
 let c=colors[active[turn]];
 document.getElementById("turn").textContent="बारी: "+c.name;
 document.getElementById("status").textContent=
  rolled?"गोटी चुनें":"पासा फेंकें";

 document.getElementById("players").innerHTML=active.map(i=>
  `<div class="player" style="border-bottom:4px solid ${colors[i].color}">
  ${colors[i].name} (${tokens[active.indexOf(i)].filter(x=>x===57).length}/4)
  </div>`
 ).join("");

 document.getElementById("roll").disabled=rolled||gameOver;
 drawTokens();
}

function canMove(pi,t){
 let s=tokens[pi][t];
 if(s===57)return false;
 if(s===-1)return dice===6;
 return s+dice<=57;
}

function rollDice(){
 if(rolled||gameOver)return;

 dice=Math.floor(Math.random()*6)+1;
 document.getElementById("dice").textContent=
  ["","⚀","⚁","⚂","⚃","⚄","⚅"][dice];

 rolled=true;
 let possible=tokens[turn].some((s,t)=>canMove(turn,t));

 if(!possible){
  document.getElementById("message").textContent=
   "कोई चाल नहीं! अगली बारी";
  rolled=false;
  setTimeout(nextTurn,900);
 }else{
  document.getElementById("message").textContent=
   "पासा आया "+dice+"! अपनी गोटी चुनें";
 }
 update();
}

function moveToken(pi,t){
 if(gameOver||!rolled||pi!==turn||!canMove(pi,t))return;

 let old=tokens[pi][t];
 let newStep=old===-1?0:old+dice;
 tokens[pi][t]=newStep;

 if(newStep<52){
  let position=(colors[active[pi]].start+newStep)%52;

  if(!safe.includes(position)){
   active.forEach((colorIndex,otherPi)=>{
    if(otherPi===pi)return;
    tokens[otherPi].forEach((s,otherToken)=>{
     if(s>=0&&s<52&&
       (colors[colorIndex].start+s)%52===position){
       tokens[otherPi][otherToken]=-1;
       document.getElementById("message").textContent=
        "⚔️ "+colors[colorIndex].name+" की गोटी कट गई!";
     }
    });
   });
  }
 }

 rolled=false;

 if(tokens[pi].every(s=>s===57)){
  gameOver=true;
  drawTokens();
  showWinner(pi);
  return;
 }

 drawTokens();

 if(dice===6){
  document.getElementById("message").textContent=
   "🎉 6 आया! आपको एक और मौका मिला";
 }else{
  turn=(turn+1)%active.length;
 }

 update();
}

function nextTurn(){
 turn=(turn+1)%active.length;
 update();
}

function showWinner(pi){
 let winner=colors[active[pi]].name;
 document.getElementById("winner").textContent=
  "🏆 "+winner+" विजेता है!";
 document.getElementById("win").style.display="flex";
 document.getElementById("message").textContent=
  "👏 बधाई हो! "+winner+" जीत गया!";
 applause();
 confetti();
}

function applause(){
 try{
  const ctx=new (window.AudioContext||window.webkitAudioContext)();
  for(let i=0;i<15;i++){
   let start=ctx.currentTime+i*.13;
   let buffer=ctx.createBuffer(1,ctx.sampleRate*.09,ctx.sampleRate);
   let data=buffer.getChannelData(0);
   for(let j=0;j<data.length;j++)
    data[j]=(Math.random()*2-1)*Math.exp(-j/data.length*6);
   let source=ctx.createBufferSource();
   let gain=ctx.createGain();
   source.buffer=buffer;
   gain.gain.setValueAtTime(.35,start);
   gain.gain.exponentialRampToValueAtTime(.001,start+.09);
   source.connect(gain);gain.connect(ctx.destination);
   source.start(start);
  }
 }catch(e){}
}

function confetti(){
 for(let i=0;i<65;i++){
  let el=document.createElement("div");
  el.textContent=["🎉","🎊","⭐","👏"][i%4];
  el.style.position="fixed";
  el.style.left=Math.random()*100+"vw";
  el.style.top="-30px";
  el.style.fontSize="25px";
  el.style.zIndex="30";
  el.style.transition="transform 3s linear,top 3s linear";
  document.body.appendChild(el);
  requestAnimationFrame(()=>{
   el.style.top="100vh";
   el.style.transform="rotate(700deg)";
  });
  setTimeout(()=>el.remove(),3200);
 }
}

function newGame(){
 document.getElementById("game").style.display="none";
 document.getElementById("menu").style.display="block";
 document.getElementById("win").style.display="none";
 document.getElementById("dice").textContent="🎲";
}

</script>
</body>
</html>
